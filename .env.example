# Demo defaults: docker compose up --build works without credentials.
EMBEDDING_PROVIDER=local
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
SEED_ON_STARTUP=true

POSTGRES_USER=interview
POSTGRES_PASSWORD=interview
POSTGRES_DB=interview
POSTGRES_PORT=5432
API_PORT=8000

# Published host ports. Services use their Docker network addresses internally.
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_PORT=50051

# Only for old Docker Desktop on Apple Silicon if the API exits with code 132:
# OPENSSL_armcap=0
